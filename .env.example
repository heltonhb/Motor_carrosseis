# Copie este arquivo para .env e preencha com sua chave real
# Obtenha em: https://aistudio.google.com

GEMINI_API_KEY=sua_chave_aqui

# Mantém false para uso local. Para produção, configure OIDC no
# .streamlit/secrets.toml e altere para true.
AUTH_REQUIRED=false

# "json" preserva o armazenamento atual; "sqlite" migra os dados existentes.
STORAGE_BACKEND=json

# true: anexa as fotos reais do catálogo refs/ ao Gemini quando gera os
# prompts de imagem (opcional; padrão false = geração só com texto).
FLOW_FOTOS=false
